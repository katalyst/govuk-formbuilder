<%# locals: (profile:) %>
<%= turbo_frame_tag example_frame_id(params[:page], params[:example]) do %>
  <%= form_with(model: profile, url: example_path(params[:page], params[:example])) do |f| %>
    <%= f.govuk_date_field :date_of_trade,
          maxlength_enabled: true,
          legend: { text: "When are you planning to trade the goods?" },
          hint: { text: "Use the format day, month, year, for example 27 3 2021" } %>

    <%= example_submit_buttons(f) %>
  <% end %>
<% end %>
