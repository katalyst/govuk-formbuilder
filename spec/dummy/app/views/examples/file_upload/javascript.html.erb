<%# locals: (profile:) %>
<%= turbo_frame_tag example_frame_id(params[:page], params[:example]) do %>
  <%= form_with(model: profile, url: example_path(params[:page], params[:example])) do |f| %>
    <%= f.govuk_file_field :profile_photo,
          label: { text: "Identification photograph" },
          hint: { text: "Upload a clear colour photograph of yourself looking straight at the camera" },
          javascript: true %>

    <%= example_submit_buttons(f) %>
  <% end %>
<% end %>
